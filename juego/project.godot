; Carreteras de España — escala 1:1
config_version=5

[application]
config/name="Carreteras de España 1:1"
config/description="Conducción por carreteras reales (OSM) con relieve real (MDT IGN) a escala 1:1"
run/main_scene="res://escenas/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Ajustes="*res://scripts/ajustes.gd"
Catalogo="*res://scripts/catalogo.gd"
Rendimiento="*res://scripts/rendimiento.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/mode.windows=3

[physics]

common/physics_interpolation=true
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.windows="forward_plus"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_vulkan=true
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
gl_compatibility/fallback_to_angle=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
